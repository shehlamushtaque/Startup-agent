# Copy this file to `.env` in the project root and fill in your keys.
# Every key is optional — the app degrades gracefully when one is absent,
# skipping that agent or falling back to template-based (non-LLM) output.

# --- LLM synthesis and Q&A -------------------------------------------------
# Powers report synthesis and the Q&A tab. Configure ONE of the options below.
# Without any of them, both fall back to deterministic templates and responses
# report `llm_used: false`.
#
# Providers are tried in this order:
#   1. Ollama  2. Groq  3. generic OpenAI-compatible  4. DeepSeek

# Option 1 - Groq. Free tier, no card required. Get a key at console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 2 - Ollama (local, free). No key needed; just run `ollama serve`.
# Only set these to override the defaults.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Option 3 - any other OpenAI-compatible endpoint (OpenAI, OpenRouter,
# Together, a self-hosted gateway). All three are required together.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Option 4 - DeepSeek.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# --- Web research ----------------------------------------------------------
# Brave Search powers WebResearchAgent.
BRAVE_API_KEY=

# SerpAPI powers SerpSearchAgent.
SERP_API_KEY=

# Google Programmable Search. Both values are needed together, or neither.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
